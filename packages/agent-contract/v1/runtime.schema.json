                "enterprise",
                "search",
                "review",
                "wiki_relations",
                "wiki_synthesis"
              ]
            },
            "budget": {
              "type": "object",
              "properties": {
                "model_requests": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "tool_calls": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                "supplement_rounds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "active_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1800
                },
                "max_input_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 24576
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "graph_steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                }
              },
              "required": [
                "model_requests",
                "tool_calls",
                "supplement_rounds",
                "active_seconds",
                "max_input_tokens",
                "max_output_tokens",
                "graph_steps"
              ],
