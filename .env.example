# Run scripts/local_postgres.py for an automatically configured Windows development setup.
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000
POSTGRES_PASSWORD=replace-with-a-random-password
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
DATABASE_URL=postgresql://policy_app:replace-with-a-random-password@127.0.0.1:55432/policy_app
CHECKPOINT_DATABASE_URL=postgresql://policy_app:replace-with-a-random-password@127.0.0.1:55432/policy_app?options=-csearch_path%3Dlanggraph
LOCAL_WORKER=false
KNOWLEDGE_SYNC_INTERVAL_MINUTES=30
REDIS_URL=redis://127.0.0.1:6379/0
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_ENABLED=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_TIMEOUT_SECONDS=5
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=policy-local
S3_SECRET_KEY=replace-with-a-random-secret
S3_BUCKET=policy-originals
# Optional. Configure locally; never send keys in chat or commit .env.
AI_BASE_URL=https://api.deepseek.com
# Ollama OpenAI-compatible example: http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_REVIEW_CONCURRENCY=3
# Knowledge pages use the configured model when enabled. Without a configured model,
# the system keeps the deterministic cited-page fallback.
KNOWLEDGE_LLM_ENABLED=true
KNOWLEDGE_RELATION_AUDIT_ENABLED=true
KNOWLEDGE_RELATION_SCANS_PER_BUILD=25
# Read-only Markdown mirror for internal Obsidian research and graph browsing.
OBSIDIAN_EXPORT_ENABLED=true
OBSIDIAN_EXPORT_DIR=output/obsidian-vault
# 配置本机 FlClash 代理即可。程序仅在 DNS 返回 VPN Fake-IP 时使用代理；
# VPN 关闭、DNS 恢复公网地址后会自动改用直连，无需改配置或重启。
POLICY_ALLOW_VPN_FAKE_IP=false
POLICY_CRAWL_PROXY_URL=
# Some legacy government sites publish HTTP pages while their HTTPS certificate is invalid.
POLICY_CRAWL_ALLOW_LEGACY_HTTP=false
# Public contact URL or email shown in the crawler User-Agent.
POLICY_CRAWLER_CONTACT=
# All Nanning list, detail and attachment requests share this cross-process pace.
POLICY_CRAWL_MIN_INTERVAL_SECONDS=5
POLICY_CRAWL_JITTER_SECONDS=3
POLICY_CRAWL_RATE_LIMIT_COOLDOWN_MINUTES=360
POLICY_CRAWL_FORBIDDEN_COOLDOWN_MINUTES=1440
POLICY_CRAWL_INCREMENTAL_LOOKBACK_DAYS=3
POLICY_CRAWL_SOURCE_INTERVAL_MINUTES=1440
# Maximum time for one policy page and its attachments; interrupted work is requeued automatically.
POLICY_IMPORT_LEASE_MINUTES=60
OPPORTUNITY_CLOSING_SOON_DAYS=7
